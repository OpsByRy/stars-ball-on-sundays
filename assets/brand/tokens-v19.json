{
 "name": "SBOS website theme tokens",
 "version": "v19 \u00b7 2026-11-05",
 "howToUse": "Set data-sbos-colorway=\"<id>\" (and optionally data-sbos-scheme=\"dark\") on <html>, then use the --sbos-* variables. Roles match the logo palette.",
 "elements": {
  "bg": {
   "light": {
    "value": "@highlight",
    "use": "Page background"
   },
   "dark": {
    "value": "@ink",
    "use": "Page background"
   }
  },
  "surface": {
   "light": {
    "value": "mix(@highlight,@trim,0.16)",
    "use": "Cards, panels, table rows"
   },
   "dark": {
    "value": "mix(@ink,@trim,0.08)",
    "use": "Cards, panels, table rows"
   }
  },
  "surface-alt": {
   "light": {
    "value": "mix(@highlight,@trim,0.34)",
    "use": "Raised or striped areas, selected rows"
   },
   "dark": {
    "value": "mix(@ink,@trim,0.16)",
    "use": "Raised or striped areas, selected rows"
   }
  },
  "border": {
   "light": {
    "value": "mix(@trim,@ink,0.22)",
    "use": "Dividers, card and input borders"
   },
   "dark": {
    "value": "mix(@ink,@trim,0.32)",
    "use": "Dividers, card and input borders"
   }
  },
  "text": {
   "light": {
    "value": "@ink",
    "against": "bg",
    "min": 7,
    "fixToward": "#000000",
    "use": "Body text"
   },
   "dark": {
    "value": "@highlight",
    "against": "bg",
    "min": 7,
    "fixToward": "#FFFFFF",
    "use": "Body text"
   }
  },
  "text-muted": {
   "light": {
    "value": "mix(@ink,@highlight,0.3)",
    "against": "bg",
    "min": 4.5,
    "fixToward": "@ink",
    "use": "Captions, timestamps, secondary text"
   },
   "dark": {
    "value": "mix(@highlight,@ink,0.3)",
    "against": "bg",
    "min": 4.5,
    "fixToward": "@highlight",
    "use": "Captions, timestamps, secondary text"
   }
  },
  "heading": {
   "light": {
    "value": "@ink",
    "against": "bg",
    "min": 4.5,
    "fixToward": "#000000",
    "use": "Headings"
   },
   "dark": {
    "value": "@trim",
    "against": "bg",
    "min": 4.5,
    "fixToward": "@highlight",
    "use": "Headings"
   }
  },
  "link": {
   "light": {
    "value": "@accent",
    "against": "bg",
    "min": 4.5,
    "fixToward": "@ink",
    "use": "Text links"
   },
   "dark": {
    "value": "@accent",
    "against": "bg",
    "min": 4.5,
    "fixToward": "@highlight",
    "use": "Text links"
   }
  },
  "link-hover": {
   "light": {
    "value": "@ink",
    "use": "Link hover and pressed"
   },
   "dark": {
    "value": "@trim",
    "use": "Link hover and pressed"
   }
  },
  "accent": {
   "light": {
    "value": "@accent",
    "use": "Badges, highlights, active tabs, rules (not small text)"
   },
   "dark": {
    "value": "@accent",
    "use": "Badges, highlights, active tabs, rules (not small text)"
   }
  },
  "on-accent": {
   "light": {
    "value": "best(@highlight,@ink,#FFFFFF,#000000)",
    "against": "accent",
    "min": 4.5,
    "fixToward": "@ink",
    "use": "Text on an accent fill"
   },
   "dark": {
    "value": "best(@highlight,@ink,#FFFFFF,#000000)",
    "against": "accent",
    "min": 4.5,
    "fixToward": "@ink",
    "use": "Text on an accent fill"
   }
  },
  "button-bg": {
   "light": {
    "value": "@ink",
    "use": "Primary button fill"
   },
   "dark": {
    "value": "@trim",
    "use": "Primary button fill"
   }
  },
  "button-text": {
   "light": {
    "value": "best(@highlight,@trim,#FFFFFF)",
    "against": "button-bg",
    "min": 4.5,
    "fixToward": "#FFFFFF",
    "use": "Primary button label"
   },
   "dark": {
    "value": "best(@ink,@highlight,#000000)",
    "against": "button-bg",
    "min": 4.5,
    "fixToward": "@ink",
    "use": "Primary button label"
   }
  },
  "star": {
   "light": {
    "value": "@star",
    "use": "Star icons, picks of the day"
   },
   "dark": {
    "value": "@star",
    "use": "Star icons, picks of the day"
   }
  },
  "focus": {
   "light": {
    "value": "@accent",
    "against": "bg",
    "min": 3,
    "fixToward": "@ink",
    "use": "Keyboard focus ring"
   },
   "dark": {
    "value": "@accent",
    "against": "bg",
    "min": 3,
    "fixToward": "@highlight",
    "use": "Keyboard focus ring"
   }
  }
 },
