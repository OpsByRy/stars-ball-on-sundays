// Deploy: npx wrangler@4 deploy -c workers/live-data/wrangler.jsonc
// No public route: only the site server (sbos-private-redesign) reaches it, through its
// PUBLISHED_DATA service binding. LIVE_LAYER "off" makes it a plain pass-through to Pages.
{
  "name": "sbos-live-data",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "account_id": "fbdf495767bb144edfcbb7f1609e2629",
  "r2_buckets": [{ "binding": "LIVE_DATA", "bucket_name": "sbos-public-data" }],
  "vars": { "LIVE_LAYER": "off" },
  "observability": { "enabled": true }
}
